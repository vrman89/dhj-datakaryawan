{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Internal and subcont employee records for DHJ Employee Data Management",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the employee"
        },
        "name": {
          "type": "string",
          "description": "Full name of the employee, minimum 3 characters",
          "minLength": 3,
          "maxLength": 100
        },
        "nik": {
          "type": "string",
          "description": "Unique employee identification number",
          "minLength": 3,
          "maxLength": 30
        },
        "nikKtp": {
          "type": "string",
          "description": "16-digit Indonesian National Identity Card Number (NIK KTP)",
          "minLength": 16,
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "description": "Residential home address",
          "minLength": 3,
          "maxLength": 500
        },
        "divisionId": {
          "type": "string",
          "description": "Assigned division identifier"
        },
        "divisionName": {
          "type": "string",
          "description": "Assigned division name",
          "maxLength": 100
        },
        "subcontId": {
          "type": "string",
          "description": "Subcont company identifier or internal"
        },
        "subcontName": {
          "type": "string",
          "description": "Subcont company name or Internal",
          "maxLength": 100
        },
        "employeeStatus": {
          "type": "string",
          "enum": ["Internal", "Subcont", "Outsourcing", "Kontrak", "Tetap", "Lainnya"],
          "description": "Employment classification"
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["Menunggu Verifikasi", "Terverifikasi", "Perlu Perbaikan", "Tidak Aktif"],
          "description": "Data verification state by admin"
        },
        "verificationNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Correction note or review feedback from Admin"
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Employee contact phone number or WhatsApp"
        },
        "ktpPhoto": {
          "type": "string",
          "description": "Base64 data URL of employee KTP image"
        },
        "facePhoto": {
          "type": "string",
          "description": "Base64 data URL of employee face/portrait image"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp ISO string"
        },
        "verifiedAt": {
          "type": "string",
          "description": "Verification timestamp"
        },
        "verifiedBy": {
          "type": "string",
          "description": "Admin email or identifier who verified"
        }
      },
      "required": [
        "name",
        "nik",
        "address",
        "divisionId",
        "divisionName",
        "subcontId",
        "subcontName",
        "employeeStatus",
        "verificationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "Division": {
      "title": "Division",
      "description": "Department or work division",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique division ID"
        },
        "name": {
          "type": "string",
          "description": "Division name",
          "minLength": 2,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Nonaktif"],
          "description": "Division active status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "status", "createdAt", "updatedAt"]
    },
    "Subcont": {
      "title": "Subcont",
      "description": "Subcontractor partner or internal vendor definition",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique subcont ID"
        },
        "name": {
          "type": "string",
          "description": "Subcontractor name",
          "minLength": 2,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Nonaktif"],
          "description": "Subcont active status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["name", "status", "createdAt", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role definition",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID"
        },
        "name": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "EMPLOYEE"],
          "description": "Application role"
        },
        "status": {
          "type": "string",
          "description": "Active status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Collection of employee and subcont manpower records"
    },
    "/divisions/{divisionId}": {
      "schema": "Division",
      "description": "Collection of operational company divisions"
    },
    "/subconts/{subcontId}": {
      "schema": "Subcont",
      "description": "Collection of subcontractor companies"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of system users and administrators"
    }
  }
}
